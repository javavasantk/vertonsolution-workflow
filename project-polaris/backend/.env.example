# Use placeholders only. Do not commit a populated .env file.
NODE_ENV=development
PORT=3000
POLARIS_ASSISTANT_ENABLED=false
POLARIS_ANALYTICS_ENABLED=false
POLARIS_ASSISTANT_MAX_INPUT_CHARACTERS=12000
POLARIS_ASSISTANT_DRAFT_TTL_SECONDS=1800
POLARIS_ASSISTANT_CONFIRMATION_TTL_SECONDS=600
# Firebase, AI provider, PostgreSQL, Redis, Cloud Storage, Cloud Tasks, KMS,
# and observability credentials are injected only through protected environment
# configuration and Secret Manager. They are intentionally not listed here.
