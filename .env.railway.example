# Railway FastAPI deployment variables. Never commit real values.
# Set this Railway build variable so Railway selects the non-root Dockerfile.
RAILWAY_DOCKERFILE_PATH=Dockerfile.railway
APP_ENV=production
DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:PORT/DATABASE
JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=verton-workforce-hub
JWT_AUDIENCE=verton-workforce-hub-web
APP_ORIGINS=https://vertonsolutions.live,https://www.vertonsolutions.live

# Private S3-compatible storage for recruiter resume uploads only.
S3_BUCKET=replace-with-private-bucket
S3_REGION=us-east-1
S3_ENDPOINT=https://replace-with-s3-endpoint
S3_ACCESS_KEY_ID=replace-with-access-key
S3_SECRET_ACCESS_KEY=replace-with-secret-key

# Independent OpenAI-compatible provider credentials for Railway.
AI_BASE_URL=https://replace-with-provider.example/v1
AI_API_KEY=replace-with-api-key
AI_MODEL=gpt-5-mini

# Do not configure Manus-only values such as OAUTH_SERVER_URL, VITE_APP_ID,
# BUILT_IN_FORGE_API_URL, or BUILT_IN_FORGE_API_KEY in Railway.
